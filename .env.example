# Copy to .env.local for local development (`vercel env pull .env.local` fills the Supabase pair).

# Supabase project (public: safe in the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Claude (server only). Haiku 5.5 summarises and connects; Sonnet 5.5 writes the hand-offs.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Or Gemini, for both text and embeddings (gemini-embedding-001 at 1536 dimensions). Claude wins for text when both
# are set; Gemini wins for embeddings. Keep one embedding provider for the life of a Vault.
GEMINI_API_KEY=xxxxxxxx
# GEMINI_MODEL_FAST=gemini-flash-lite-latest
# GEMINI_MODEL_SMART=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Embeddings: OpenAI text-embedding-3-small, 1536 dimensions (server only)
OPENAI_API_KEY=sk-xxxxxxxx

# Optional instead of the two keys above: one Vercel AI Gateway key for both Claude and embeddings
# AI_GATEWAY_API_KEY=vck_xxxxxxxx
# Or, on Vercel with a card on the team, use the deployment's OIDC token for the gateway:
# AI_GATEWAY_USE_OIDC=1
